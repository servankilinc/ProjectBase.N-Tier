@using WebUI.Models.ViewModels.Blog
@model BlogViewModel
@{
    ViewData["Title"] = "Blogs";
}

@await Html.PartialAsync("Partials/Toolbar", new Breadcrum
{
    BreadcrumbItems = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "Home", Path = Url.Action("Index", "Home") },
    },
    PageName = ViewData["Title"]?.ToString() ?? "Page"
})

<link href="~/metronic/plugins/custom/datatables/datatables.bundle.css" rel="stylesheet" />

<div class="card card-flush">
    <div class="card-header align-items-center py-5 gap-2 gap-md-5">
        <div class="card-title">
            <div class="menu menu-sub menu-sub-dropdown mt-2 w-75 w-lg-500px" data-kt-menu="true">
                <div class="px-7 py-5">
                    <div class="fs-5 text-gray-900 fw-bold">Filter Options</div>
                </div>
                <div class="separator border-gray-200"></div>
                <div class="mb-10">
                    <label class="form-label fw-semibold">Author</label>
                    <select name="AuthorId" asp-items="Model.AuthorIds" class="autoInitSelect2 form-select form-control-solid">
                        <option></option>
                    </select>
                </div>
                <div class="mb-10">
                    <label class="form-label fw-semibold">Title</label>
                    <input name="Title" type="text" class="form-control form-control-solid" />
                </div>
                <div class="mb-10">
                    <label class="form-label fw-semibold">Category</label>
                    <select name="CategoryId" asp-items="Model.CategoryIds" class="autoInitSelect2 form-select form-control-solid">
                        <option></option>
                    </select>
                </div>
                <div class="mb-10">
                    <label class="form-label fw-semibold">Date</label>
                    <input name="Date" type="text" class="autoInitFlatPicker form-control form-control-solid" />
                </div>
                <div class="mb-10">
                    <div class="form-check form-switch form-switch-sm form-check-custom form-check-solid">
                        <input name="IsDeleted" value="false" type="hidden" />
                        <input name="IsDeleted" value="true" type="checkbox" class="form-check-input" />
                        <span class="form-check-label fs-sm">Include Deleted</span>
                    </div>
                </div>
            </div>

            <button class="btn btn-sm btn-flex btn-light-dark fw-bold" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-start">
                <i class="ki-duotone ki-filter fs-6 text-muted me-1"><span class="path1"></span><span class="path2"></span></i>
                Filter
            </button>
        </div>
    </div>

    <div class="card-body p-4 pt-0">
        <table id="table_blog" class="table table-hover table-striped">
            <thead class="bg-light">
                <tr>
                    <!-- Unique Field'ları Alma -->
                    <!-- Report Dto oluştururken kullandığın ilişkili Field'ları Alma -->
                    <th>Author Name</th> <!-- CamelCase arasına boşluk koy -->
                    <th>Title</th>
                    <th>Content</th>
                    <th>Category Name</th>
                    <th>Date</th>
                    <th>Banner Image</th>
                    <th>Like Count</th>
                    <th>Comment Count</th>
                    <!-- entity auditable ise -->
                    <th>Create Date</th>
                    <th>Last Update Date</th>
                    <!-- entity soft deletable ise-->
                    <th>Status</th>
                    <th>Delete Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/metronic/plugins/custom/datatables/datatables.bundle.js"></script>

    <script>

        let PageTable;

        $(document).ready(function(){
            InitilazeTable();
        })

        function InitilazeTable(e) {

            PageTable = DatatableManager.Create({
                serverSide: true,
                tableId: 'table_blog',
                path: 'Blog/DatatableServerSide',
                method: 'Post',
                buttonElement: e,
                requestData: {
                    filter: {
                        operator: 'base',
                        logic: 'and',
                        filters: [
                            {
                                operator: 'eq',
                                field: "AuthorId",
                                value: $("select[name='AuthorId']").val(),
                            },
                            {
                                operator: 'contains',
                                field: "Title",
                                value: $("input[name='Title']").val(),
                            },
                            {
                                operator: 'eq',
                                field: "CategoryId",
                                value: $("select[name='CategoryId']").val(),
                            },
                            {
                                operator: 'eq',
                                field: "Date",
                                value: $("input[name='Date']").val(),
                            },
                            {
                                operator: 'base',
                                logic: 'or',
                                filters: [
                                    {
                                        operator: 'eq',
                                        field: "IsDeleted",
                                        value: false,
                                    },
                                    {
                                        operator: 'eq',
                                        field: "IsDeleted",
                                        value: $('input[name="IsDeleted"]:checked').prop("checked") || false,
                                    }
                                ]
                            }
                        ]
                    }
                },
                columns: [
                    { data: 'authorName' },
                    { data: 'title' },
                    { data: 'content' },
                    { data: 'categoryName' },
                    { data: 'date' },
                    { data: 'bannerImage' },
                    { data: 'likeCount' },
                    { data: 'likeCount' },
                    { data: 'commentCount' },
                    {
                        data: 'createDateUtc',
                        render: function (data) {
                            if(data == null) return '';
                            return moment(data).format('DD.MM.YYYY HH:mm');
                        }
                    },
                    {
                        data: 'updateDateUtc',
                        render: function (data) {
                            if(data == null) return '';
                            return moment(data).format('DD.MM.YYYY HH:mm');
                        }
                    },
                    {
                        data: 'isDeleted',
                        render: function (data) {
                            if(data == true) return (`<span class="badge rounded-pill bg-label-danger"><i class="fa-solid fa-xmark"></i></span>`);
                            else if(data == false) return (`<span class="badge rounded-pill bg-label-success"><i class="fa-solid fa-check"></i></span>`);
                            else return ('');
                        }
                    },
                    {
                        data: 'deletedDateUtc',
                        render: function (data) {
                            if(data == null) return '';
                            return moment(data).format('DD.MM.YYYY HH:mm');
                        }
                    },
                    {
                        data: null,
                        defaultContent: '',
                        searchable: false,
                        createdCell: function (td, cellData, rowData, row, col)
                        {
                            let deleteHandleButton = rowData.isDeleted == true ?
                                HelperService.UndoDeleteButtonTable({ requestUrl: 'Blog/UndoDelete', requestData: { "id": rowData.id }, pageTable: PageTable }) :
                                HelperService.DeleteButtonTable({requestUrl: 'Blog/Delete', requestData: { "id": rowData.id }, pageTable: PageTable});

                            DatatableManager.AppendRowButtons(td,
                                [
                                    // 1) Update Button
                                    HelperService.UpdateButtonTable({
                                        title: 'Update User Informations',
                                        formGetterUrl: 'Blog/Update',
                                        requestData: {
                                            "id": rowData.id
                                        },
                                        pageTable: PageTable
                                    }),
                                    deleteHandleButton
                                ]
                            );
                        }
                    }
                ],
                customButtons:
                [
                    {
                        text: '<span class="dynamic-content"><i class="fa-solid fa-file-circle-plus me-2"></i>Add New Blog</span>',
                        className: 'btn btn-primary mx-2',
                        action: (e_btn) =>
                        {
                            HelperService.InsertModal({
                                title: 'Add New Blog',
                                formGetterUrl: 'Blog/Create',
                                e_btn: e_btn.currentTarget,
                                pageTable: PageTable
                            })
                        }
                    }
                ]
            })
        }
    </script>
}