@using WebUI.Models.ViewModels.User
@model UserViewModel
@{
    ViewData["Title"] = "Users";
}

<link href="~/metronic/plugins/custom/datatables/datatables.bundle.css" rel="stylesheet" />

<div class="card card-flush">
	<div class="card-header align-items-center py-5 gap-2 gap-md-5">
		<div class="card-title">  @* <div class="card-toolbar flex-row-fluid justify-content-end gap-5"> *@
			<form id="form_user_filter">
				<div class="row row-gap-4">
					<div class="col-md-4 col-md-6 col-12">
                        <div class="input-group input-group-sm">
							<span class="input-group-text bg-lightest">
								Name
							</span>
							<input name="Name" type="text" class="form-control" />
						</div>
					</div>
					<div class="col-md-4 col-md-6 col-12">
                        <div class="input-group input-group-sm">
							<span class="input-group-text bg-lightest">
								Last Name
							</span>
							<input name="LastName" type="text" class="form-control" />
						</div>
					</div>
					<div class="col-md-4 col-md-6 col-12">
                        <div class="input-group input-group-sm">
							<span class="input-group-text bg-lightest">
								Email
							</span>
							<input name="Email" type="text" class="form-control" />
						</div>
					</div>
					<div class="col-md-4 col-md-6 col-12">
                        <div class="input-group input-group-sm">
							<span class="input-group-text bg-lightest">
								Include Deleted
							</span>
							<div class="input-group-text">
								<input name="IsDeleted" value="false" type="hidden" />
								<input name="IsDeleted" value="true" type="checkbox" class="form-check-input" />
							</div>
						</div>
					</div>
					<div class="col-md-3 col-sm-4 col-6">
						<button onclick="InitilazeTable(this)" type="button" class="btn btn-sm btn-light-dark">
							<span class="dynamic-content">
								<i class="fa-solid fa-search me-2"></i>
								Search
							</span>
						</button>
					</div>
				</div>
			</form>
		</div>
	</div>

	<div class="card-body pt-0">

		<table id="table_user" class="table align-middle table-row-dashed fs-6 gy-5">
            <thead >
				<tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
					<th class="text-start w-10px pe-2">
						<div class="form-check form-check-sm form-check-custom form-check-solid me-3">
							<input class="form-check-input" type="checkbox" data-kt-check="true" data-kt-check-target="#table_user .form-check-input" value="1" />
						</div>
					</th>
					<th>Name</th> <!-- CamelCase arasına boşluk koy -->
					<th>Last Name</th>
					<th>Email</th>
					<th>Addres</th>
					<th>BirthDate</th>
					<!-- entity auditable ise -->
					<th>Create Date</th>
					<th>Last Update Date</th>
					<!-- entity soft deletable ise-->
					<th>Status</th>
					<th>Delete Date</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody class="fw-semibold text-gray-600">
			</tbody>
		</table>
	</div>
</div>

@section Scripts {
    <script src="~/metronic/plugins/custom/datatables/datatables.bundle.js"></script>

    <script>

        let PageTable;

        $(document).ready(function(){
            InitilazeTable();
        })

        function InitilazeTable(e) {

            PageTable = DatatableManager.Create({
                serverSide: true,
                tableId: 'table_user',
                path: 'User/DatatableServerSide',
                method: 'Post',
                buttonElement: e,
                requestData: {
                    filter: {
                        operator: 'base',
                        logic: 'and',
                        filters: [
                            {
                                operator: 'contains',
                                field: "Name",
                                value: $("input[name='Name']").val() || "",
                            },
                            {
                                operator: 'contains',
                                field: "LastName",
                                value: $("input[name='LastName']").val() || "",
                            },
                            {
                                operator: 'contains',
                                field: "Email",
                                value: $("input[name='Email']").val() || "",
                            },
                            {
                                operator: 'eq',
                                field: "IsDeleted",
                                value: false,
                                logic: 'or',
                                filters: [
                                    {
                                        operator: 'eq',
                                        field: "IsDeleted",
                                        value: $("input[name='IsDeleted']").prop("checked"),
                                    }
                                ]
                            }
                        ]
                    }
                },
                columns: [
                    {
                        targets: 0,
                        orderable: false,
                        render: function (data) {
                            return `
                                <div class="form-check form-check-sm form-check-custom form-check-solid">
                                    <input class="form-check-input" type="checkbox" value="${data}" />
                                </div>`;
                        }
                    },
                    { data: 'name' },
                    { data: 'lastName' },
                    { data: 'email' },
                    { data: 'addres' },
                    {
                        data: 'birthDate',
                        render: function (data) {
                            if(data == null) return '';
                            return moment(data).format('DD.MM.YYYY HH:mm');
                        }
                    },
                    {
                        data: 'createDateUtc',
                        render: function (data) {
                            if(data == null) return '';
                            return moment(data).format('DD.MM.YYYY HH:mm');
                        }
                    },
                    {
                        data: 'updateDateUtc',
                        render: function (data) {
                            if(data == null) return '';
                            return moment(data).format('DD.MM.YYYY HH:mm');
                        }
                    },
                    {
                        data: 'isDeleted',
                        render: function (data) {
                            if(data == true) return (`<span class="badge rounded-pill bg-label-danger"><i class="fa-solid fa-xmark"></i></span>`);
                            else if(data == false) return (`<span class="badge rounded-pill bg-label-success"><i class="fa-solid fa-check"></i></span>`);
                            else return ('');
                        }
                    },
                    {
                        data: 'deletedDateUtc',
                        render: function (data) {
                            if(data == null) return '';
                            return moment(data).format('DD.MM.YYYY HH:mm');
                        }
                    },
                    {
                        data: null,
                        defaultContent: '',
                        searchable: false,
                        createdCell: function (td, cellData, rowData, row, col)
                        {
                            let deleteHandleButton = rowData.isDeleted == true ?
                                HelperService.UndoDeleteButtonTable({
                                    requestUrl: 'User/UndoDelete',
                                    requestData: {
                                        "id": rowData.id
                                    },
                                    pageTable: PageTable
                                }) :
                                HelperService.DeleteButtonTable({
                                    requestUrl: 'User/Delete',
                                    requestData: {
                                        "id": rowData.id
                                    },
                                    pageTable: PageTable
                                });

                            DatatableManager.AppendRowButtons(td,
                                [
                                    // 1) Update Button
                                    HelperService.UpdateButtonTable({
                                        title: 'Update User Informations',
                                        formGetterUrl: 'User/Update',
                                        requestData: {
                                            "id": rowData.id
                                        },
                                        pageTable: PageTable
                                    }),
                                    // 2) Delete Button
                                    deleteHandleButton
                                ]
                            );
                        }
                    }
                ],
                customButtons:
                [
                    // 1) Create Button
                    {
                        text: '<span class="dynamic-content"><i class="fa-solid fa-file-circle-plus me-2"></i>Add New User</span>',
                        className: 'btn btn-primary mx-2',
                        action: (e_btn) =>
                        {
                            HelperService.InsertModal({
                                title: 'Add New User',
                                formGetterUrl: 'User/Create',
                                e_btn: e_btn.currentTarget,
                                pageTable: PageTable
                            })
                        }
                    }
                ]
            })
        }
    </script>
}