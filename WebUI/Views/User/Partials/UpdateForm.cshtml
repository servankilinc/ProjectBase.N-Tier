@using WebUI.Models.ViewModels.User
@model UserUpdateViewModel
@{
    Layout = null;
}

<form asp-controller="User" asp-action="Update" method="post">
    <input asp-for="UpdateModel.Id" type="hidden" class="form-control" />
    <div class="row row-gap-4 m-2">
        <div class="col-md-6">
            <label asp-for="UpdateModel.Name" class="form-label">
                Name
            </label>
            <input asp-for="UpdateModel.Name" type="text" class="form-control" />
            <span asp-validation-for="UpdateModel.Name" class="form_validation_feedback"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="UpdateModel.LastName" class="form-label">
                Last Name
            </label>
            <input asp-for="UpdateModel.LastName" type="text" class="form-control" />
            <span asp-validation-for="UpdateModel.LastName" class="form_validation_feedback"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="UpdateModel.Addres" class="form-label">
                Addres
            </label>
            <input asp-for="UpdateModel.Addres" type="text" class="form-control" />
            <span asp-validation-for="UpdateModel.Addres" class="form_validation_feedback"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="UpdateModel.BirthDate" class="form-label">
                Birth Date
            </label>
            <input asp-for="UpdateModel.BirthDate" type="text" class="form-control autoInitDatePicker" />
            <span asp-validation-for="UpdateModel.BirthDate" class="form_validation_feedback"></span>
        </div>
        @* <div class="col-md-6">
            <label asp-for="CreateModel.RoleList" class="form-label">
                Kullanıcı Rol Listesi
            </label>
            <select asp-for="CreateModel.RoleList" asp-items="Model.RoleSelectList" class="autoInitSelect2 form-select" multiple="multiple">
                <option></option>
            </select>
            <span asp-validation-for="CreateModel.RoleList" class="form_validation_feedback"></span>
        </div> *@
    </div>
</form>