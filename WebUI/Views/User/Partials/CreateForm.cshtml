@using WebUI.Models.ViewModels.User
@model UserCreateViewModel
@{
    Layout = null;
}

<form asp-controller="User" asp-action="Create" method="post">
    <div class="row row-gap-4 m-2">
        <div class="col-md-6">
            <label asp-for="CreateModel.Name" class="form-label">
                Name
            </label>
            <input asp-for="CreateModel.Name" type="text" class="form-control" />
            <span asp-validation-for="CreateModel.Name" class="form_validation_feedback"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CreateModel.LastName" class="form-label">
                Last Name
            </label>
            <input asp-for="CreateModel.LastName" type="text" class="form-control" />
            <span asp-validation-for="CreateModel.LastName" class="form_validation_feedback"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CreateModel.Email" class="form-label">
                Email
            </label>
            <input asp-for="CreateModel.Email" type="text" class="form-control" />
            <span asp-validation-for="CreateModel.Email" class="form_validation_feedback"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CreateModel.Addres" class="form-label">
                Addres
            </label>
            <input asp-for="CreateModel.Addres" type="text" class="form-control" />
            <span asp-validation-for="CreateModel.Addres" class="form_validation_feedback"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CreateModel.BirthDate" class="form-label">
                BirthDate
            </label>
            <input asp-for="CreateModel.BirthDate" type="text" class="form-control autoInitDatePicker" />
            <span asp-validation-for="CreateModel.BirthDate" class="form_validation_feedback"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="CreateModel.Password" class="form-label">
                Password
            </label>
            <input asp-for="CreateModel.Password" type="text" class="form-control" />
            <span asp-validation-for="CreateModel.Password" class="form_validation_feedback"></span>
        </div>        
        @* <div class="col-md-6">
            <label asp-for="CreateModel.RoleList" class="form-label">
                Kullanıcı Rol Listesi
            </label>
            <select asp-for="CreateModel.RoleList" asp-items="Model.RoleSelectList" class="autoInitSelect2 form-select" multiple="multiple">
                <option></option>
            </select>
            <span asp-validation-for="CreateModel.RoleList" class="form_validation_feedback"></span>
        </div> *@
    </div>
</form>